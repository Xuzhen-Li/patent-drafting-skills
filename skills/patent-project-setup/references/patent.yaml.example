# patent.yaml
# Copy into the project root. Delete these comment lines in the project copy
# if a strict YAML loader complains. Gates stay false until a human closes them.

title: "[INVENTOR TO CONFIRM]"
jurisdiction: US          # US | PCT
language: en              # always en in this suite
field: "[INVENTOR TO CONFIRM]"

applicant:
  name: "[INVENTOR TO CONFIRM]"
  type: "[INVENTOR TO CONFIRM]"   # individual | company | university | other
  address: ""               # city and country are enough; no national ID

inventors:
  - name: "[INVENTOR TO CONFIRM]"
    role: "[INVENTOR TO CONFIRM]"  # what they conceived; not a paper author list
    country: ""

public_disclosure:
  any: unknown              # yes | no | unknown
  earliest_date: ""         # ISO date if known
  note: ""

drawings: pending           # pending | none | planned
filing_intent: invention    # utility (invention) patent only

gates:
  invention_lock: false
  prior_art_review: false
  inventive_point_lock: false
  claim_set_lock: false
  final_package: false
